{
  "name": "nexuslocal-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:scene",
    "build": "tsc && vite build",
    "prebuild": "npm run build:scene",
    "build:scene": "vite build -c vite.scene.config.ts",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts src/ui/*.test.ts src/ui/lib/*.test.ts && npm run test:ui",
    "check:i18n": "node scripts/check-i18n.mjs proactive",
    "check:i18n:all": "node scripts/check-i18n.mjs",
    "test:ui": "node scripts/test-correction-ui.mjs"
  },
  "dependencies": {
    "@types/recharts": "^1.8.29",
    "i18next": "^26.3.5",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^9.0.1",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.21.5",
    "react-test-renderer": "^18.3.1",
    "three": "^0.186.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0"
  }
}
