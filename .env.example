# NexusLocal — Variáveis de Ambiente
# As chaves abaixo são opcionais — você pode configurá-las
# pelo painel Admin da interface em vez de editar este arquivo.
#
# Se preferir via arquivo, copie para .env e preencha:

GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=

# Configurações de Deploy (Multi-domínio ou Proxy Nginx)
# Defina caso queira usar domínios separados para o Frontend e a API
VITE_API_URL=
VITE_WS_URL=
ALLOWED_ORIGINS=
