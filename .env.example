# NexusLocal — Variáveis de Ambiente
# As chaves abaixo são opcionais — você pode configurá-las
# pelo painel Admin da interface em vez de editar este arquivo.
#
# Se preferir via arquivo, copie para .env e preencha:

# ── OBRIGATÓRIO ─────────────────────────────────────────────────────────────
# Chave secreta para assinatura de tokens JWT.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# ── Provedores Gratuitos (Free Tiers / API Keys Opcionais) ───────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
SILICONFLOW_API_KEY=
LONGCAT_API_KEY=
FREETHEAI_API_KEY=
LLM7_API_KEY=
ZENMUX_API_KEY=
ZAI_API_KEY=
HUGGINGFACE_API_KEY=

# Cloudflare (para tunel e Workers AI)
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Provedores Comercial / Pagos (Opcionais) ────────────────────────────────
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# ── Configurações de Deploy (Multi-domínio ou Proxy Nginx) ───────────────────
# Deixe VITE_API_URL e VITE_WS_URL vazios para usar o proxy Nginx (domínio único - recomendado)
# Preencha apenas se quiser usar domínios separados (ex: api.seu-dominio.com)
VITE_API_URL=
VITE_WS_URL=
ALLOWED_ORIGINS=

# ── Cloudflare Tunnel — Public Hostnames (referência; não usados pelo app) ──
# Exemplo de produção (Zero Trust → Tunnel → Public Hostname):
#   seu-dominio.com      →  http://nexus_frontend:80   (UI + proxy Nginx)
#   api.seu-dominio.com  →  http://nexus_backend:8000  (backend direto)
# Com VITE_* vazios o browser usa só o host da UI; o host da API é opcional (debug).
PUBLIC_HOST_UI=https://seu-dominio.com
PUBLIC_HOST_API=https://api.seu-dominio.com
TUNNEL_SERVICE_UI=http://nexus_frontend:80
TUNNEL_SERVICE_API=http://nexus_backend:8000
