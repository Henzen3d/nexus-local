# NexusLocal — Variáveis de Ambiente
# As chaves abaixo são opcionais — você pode configurá-las
# pelo painel Admin da interface em vez de editar este arquivo.
#
# Se preferir via arquivo, copie para .env e preencha:

# ── OBRIGATÓRIO ─────────────────────────────────────────────────────────────
# Chave secreta para assinatura de tokens JWT (mínimo recomendado: 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# ── Segurança / limites (opcionais) ─────────────────────────────────────────
# Segredo usado para assinar as URLs de anexos (/attachments/...?exp=&sig=).
# Se vazio, é derivado do JWT_SECRET. Trocar este valor invalida URLs antigas
# (a UI gera URLs novas a cada carregamento, então o impacto é só em links copiados).
ATTACHMENTS_SIGNING_SECRET=
# Validade (segundos) das URLs assinadas de anexos. Padrão: 7 dias.
ATTACHMENTS_URL_TTL_SECONDS=
# Teto de tokens de HISTÓRICO enviados por turno (poda das mensagens mais antigas).
# Limites por provedor/TPM continuam valendo (ex.: Groq ≤ 7500). Padrão: 32000.
HISTORY_INPUT_TOKEN_CAP=
# Caminho do banco SQLite (padrão: backend/nexuslocal.db). Útil para testes/volumes.
# DB_PATH=

# ── Assistente Proativo (opt-in por usuário; docs em melhorias/assistente-proativo/) ──
# Precedência: valor salvo em `meta` (painel admin) > variável de ambiente > padrão.
# Ou seja: estas variáveis só definem o ponto de partida; o painel admin pode
# sobrescrevê-las em tempo real (sem reiniciar). Todas são opcionais.
# PROACTIVE_ENABLED_GLOBAL=true               # kill-switch global (false ⇒ nada é detectado/entregue)
# PROACTIVE_ONBOARDING_ENABLED=false          # semana 2 do rollout: libera o modal de convite
# PROACTIVE_DETECTOR_PROVIDER_ID=             # vazio ⇒ modelo da conversa
# PROACTIVE_DETECTOR_MODEL_ID=
# PROACTIVE_SYNTH_PROVIDER_ID=                # vazio ⇒ mesmo do detector
# PROACTIVE_SYNTH_MODEL_ID=
# PROACTIVE_ALLOW_CHAT_MODEL_FALLBACK=false   # se o modelo configurado falhar, usa o da conversa
# PROACTIVE_MAX_PER_HOUR_CONV=3               # insights por hora por conversa
# PROACTIVE_MAX_PER_DAY_USER=10               # insights por dia por usuário
# PROACTIVE_TOPIC_COOLDOWN_HOURS=24           # mesmo tema (topic_hash) só a cada N h
# PROACTIVE_MAX_PENDING=3                     # máx. insights "ready" aguardando o usuário
# PROACTIVE_CONCURRENCY=2                     # pipelines simultâneos (semáforo global)
# PROACTIVE_TOTAL_TIMEOUT_S=45                # pesquisa + síntese
# PROACTIVE_RESEARCH_TIMEOUT_S=30
# PROACTIVE_SYNTH_TIMEOUT_S=20
# PROACTIVE_EXPIRY_NEWS_HOURS=48              # validade de insights de notícia
# PROACTIVE_EXPIRY_DEFAULT_DAYS=7             # validade das demais categorias (evento usa a data do evento)

# ── Web Push / PWA (Fase 6 — Opcional) ──────────────────────────────────────
# Se não configuradas, o NexusLocal gera automaticamente um par de chaves VAPID
# no primeiro boot e persiste na tabela `meta` do SQLite.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@nexuslocal.internal

# ── Assistente Proativo — avaliação offline do detector (opcional, só dev) ──
# Usados por scripts/proactive_eval.py --llm e pelo teste test_gold_llm_metrics.
# O script usa um SQLite temporário próprio (nunca o nexuslocal.db) e a chave do
# provedor vem de <PROVIDER>_API_KEY abaixo (ou de PROACTIVE_EVAL_API_KEY).
# PROACTIVE_EVAL_PROVIDER=groq
# PROACTIVE_EVAL_MODEL=llama-3.1-8b-instant
# PROACTIVE_EVAL_API_KEY=

# ── Provedores Gratuitos (Free Tiers / API Keys Opcionais) ───────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
SILICONFLOW_API_KEY=
LONGCAT_API_KEY=
FREETHEAI_API_KEY=
LLM7_API_KEY=
ORCAROUTER_API_KEY=
BYNARA_API_KEY=
ZENMUX_API_KEY=
ZAI_API_KEY=
HUGGINGFACE_API_KEY=

# Cloudflare (para tunel e Workers AI)
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Provedores Comercial / Pagos (Opcionais) ────────────────────────────────
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# ── Configurações de Deploy (Multi-domínio ou Proxy Nginx) ───────────────────
# Deixe VITE_API_URL e VITE_WS_URL vazios para usar o proxy Nginx (domínio único - recomendado)
# Preencha apenas se quiser usar domínios separados (ex: api.seu-dominio.com)
VITE_API_URL=
VITE_WS_URL=
ALLOWED_ORIGINS=

# ── Cloudflare Tunnel — Public Hostnames (referência; não usados pelo app) ──
# Exemplo de produção (Zero Trust → Tunnel → Public Hostname):
#   seu-dominio.com      →  http://nexus_frontend:80   (UI + proxy Nginx)
#   api.seu-dominio.com  →  http://nexus_backend:8000  (backend direto)
# Com VITE_* vazios o browser usa só o host da UI; o host da API é opcional (debug).
PUBLIC_HOST_UI=https://seu-dominio.com
PUBLIC_HOST_API=https://api.seu-dominio.com
TUNNEL_SERVICE_UI=http://nexus_frontend:80
TUNNEL_SERVICE_API=http://nexus_backend:8000

# ── Intelligent UI (Controlled & Open Generative UI Spectrum) ────────────────
# Valores iniciais. Depois que um admin salvar em Configurações → Ferramentas →
# Interface Inteligente, a tabela `intelligent_ui_config` passa a mandar e estas
# variáveis deixam de ser lidas (sem precisar de restart).
# Desligado: o chat é idêntico ao de antes do recurso (sem catálogo no prompt,
# sem extração do fence, sem blocos na bolha).
INTELLIGENT_UI_ENABLED=false
# Hosts remotos de onde o cartão pode carregar imagem (separados por vírgula).
# Arquivos do próprio app (/attachments/...) sempre passam. Vazio = só locais.
INTELLIGENT_UI_IMAGE_HOSTS=
# Permite http:// em IP privado / .local (ex.: câmera ou NAS da casa). Padrão: não.
INTELLIGENT_UI_ALLOW_PRIVATE_HTTP=false
